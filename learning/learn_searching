# 加载 PDF → 切分 → 向量化 → 持久化存储 → 向量召回
import os
import hashlib
from pathlib import Path

from dotenv import load_dotenv
from langchain_community.document_loaders import PyPDFLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_openai import OpenAIEmbeddings
from langchain_chroma import Chroma

# 1. 配置路径
project_dir = Path(r"D:\VsCodeProjects\CampusMind")
file_path = project_dir / "data" / "campus_text.pdf"
db_path = project_dir / "data" / "chroma_db"

# 2. 读取硅基流动密钥
load_dotenv(project_dir / ".env")

api_key = os.getenv("SILICONFLOW_API_KEY")

if not api_key:
    raise ValueError("请检查 .env 中的 SILICONFLOW_API_KEY")

if not file_path.is_file():
    raise FileNotFoundError(f"找不到 PDF：{file_path}")

# 3. 加载 PDF
loader = PyPDFLoader(str(file_path))
pages = loader.load()

# 4. 切分文本
text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=100,
    chunk_overlap=20,
    length_function=len,
)

chunks = text_splitter.split_documents(pages)

chunks = [
    chunk for chunk in chunks
    if chunk.page_content.strip()
]

if not chunks:
    raise ValueError("没有提取到文字，请检查 PDF 是否为扫描件")

# 5. 创建嵌入模型客户端
embeddings_model = OpenAIEmbeddings(
    model="BAAI/bge-m3",
    api_key=api_key,
    base_url="https://api.siliconflow.cn/v1",
    check_embedding_ctx_length=False,
    chunk_size=16,
)

# 6. 创建或打开本地 Chroma 数据库
vector_store = Chroma(
    collection_name="campus_bge_m3_v1",
    embedding_function=embeddings_model,
    persist_directory=str(db_path),
)

# 7. 为每个切片生成固定 ID
chunk_ids = []

for i, chunk in enumerate(chunks):
    chunk.metadata = {
        key: value
        for key, value in chunk.metadata.items()
        if isinstance(value, (str, int, float, bool))
    }
    chunk.metadata["chunk_index"] = i

    identity = (
        f"{file_path.resolve()}\n"
        f"{chunk.metadata.get('page', 0)}\n"
        f"{i}\n"
        f"{chunk.page_content}"
    )

    chunk_id = hashlib.sha256(
        identity.encode("utf-8")
    ).hexdigest()

    chunk_ids.append(chunk_id)

# 8. 分批写入，跳过已经存在的片段
batch_size = 16
added_count = 0
skipped_count = 0

for start in range(0, len(chunks), batch_size):
    batch_chunks = chunks[start:start + batch_size]
    batch_ids = chunk_ids[start:start + batch_size]

    existing = vector_store.get(
        ids=batch_ids,
        include=[],
    )
    existing_ids = set(existing["ids"])

    new_chunks = []
    new_ids = []

    for chunk, chunk_id in zip(batch_chunks, batch_ids):
        if chunk_id in existing_ids:
            skipped_count += 1
        else:
            new_chunks.append(chunk)
            new_ids.append(chunk_id)

    if new_chunks:
        vector_store.add_documents(
            documents=new_chunks,
            ids=new_ids,
        )
        added_count += len(new_chunks)

print(
    f"入库完成：共 {len(chunks)} 个片段，"
    f"新增 {added_count} 个，跳过 {skipped_count} 个。"
)

# 9. 普通相似度检索
query = "借的书还没看完，到期了能延期吗？"

results = vector_store.similarity_search(
    query=query,
    k=2,  # 返回最相近的两个片段
)

# 10. 打印检索结果
print(f"\n问题：{query}")

if not results:
    print("没有检索到片段。")

for i, doc in enumerate(results, start=1):
    print(f"\n--- 检索结果 {i} ---")
    print(doc.page_content)

    source = doc.metadata.get("source", "未知来源")
    page = doc.metadata.get("page")
    page_number = page + 1 if isinstance(page, int) else "未知"

    print(f"来源：{source}")
    print(f"PDF 页码：{page_number}")

# 11. 测试 MMR 召回
mmr_results = vector_store.max_marginal_relevance_search(
    query=query,       # 沿用问题：借的书还没看完，到期了能延期吗？
    k=2,               # 最终返回 2 个片段
    fetch_k=6,         # 先找出最多 6 个候选片段
    lambda_mult=0.5,   # 平衡相关性和多样性
)

print(f"\n问题：{query}")
print("\n===== MMR 召回结果 =====")

for i, doc in enumerate(mmr_results, start=1):
    print(f"\n--- MMR 结果 {i} ---")
    print(doc.page_content)

    source = doc.metadata.get("source", "未知来源")
    page = doc.metadata.get("page")
    page_number = page + 1 if isinstance(page, int) else "未知"

    print(f"来源：{source}")
    print(f"PDF 页码：{page_number}")

# 12. 测试 BM25 + 向量混合召回
import jieba
from langchain_core.documents import Document
from langchain_community.retrievers import BM25Retriever

# 从数据库读取所有片段的正文和元数据
stored = vector_store.get(
    include=["documents", "metadatas"],
)

documents = [
    Document(page_content=text, metadata=metadata or {})
    for text, metadata in zip(
        stored["documents"],
        stored["metadatas"],
    )
    if text and text.strip()
]

if not documents:
    raise ValueError("数据库中没有文本，请先完成入库")


# 中文分词：文档和问题都使用这个函数
def tokenize_chinese(text):
    return [
        word.lower()
        for word in jieba.lcut(text)
        if word.strip() and any(char.isalnum() for char in word)
    ]


# 创建 BM25 检索器
bm25_retriever = BM25Retriever.from_documents(
    documents,
    preprocess_func=tokenize_chinese,
)
bm25_retriever.k = min(3, len(documents))

# 两路使用同一个问题
query = "借的书还没看完，到期了能延期吗？"

# 第一路：BM25 关键词召回，最多 3 条候选
bm25_results = bm25_retriever.invoke(query)

# 第二路：向量召回，最多 3 条候选
vector_results = vector_store.similarity_search(
    query=query,
    k=min(3, len(documents)),
)


# 根据来源、位置和正文识别同一个片段
def document_key(doc):
    return (
        doc.metadata.get("source", ""),
        doc.metadata.get("page", -1),
        doc.metadata.get("chunk_index", -1),
        doc.page_content,
    )


# 使用 RRF：按两路排名融合，而不是直接相加原始分数
scores = {}
doc_map = {}

for result_list in [bm25_results, vector_results]:
    for rank, doc in enumerate(result_list, start=1):
        key = document_key(doc)
        doc_map[key] = doc

        # 两路权重相同；排名越靠前，加分越多
        scores[key] = scores.get(key, 0) + 0.5 / (60 + rank)

# 按融合得分排序，最终取 2 条
ranked_keys = sorted(scores, key=scores.get, reverse=True)
hybrid_results = [doc_map[key] for key in ranked_keys[:2]]


# 打印三组结果，方便对照
def show_results(title, results):
    print(f"\n===== {title} =====")

    for i, doc in enumerate(results, start=1):
        print(f"\n--- 第 {i} 条 ---")
        print(doc.page_content)


print(f"\n测试问题：{query}")
show_results("BM25 候选结果", bm25_results)
show_results("向量候选结果", vector_results)
show_results("混合召回最终结果", hybrid_results)