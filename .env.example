# CampusMind 环境配置示例（不包含真实密钥）
# 首次配置：复制本文件为项目根目录的 .env，再填写下面的密钥。
# 如果已有 .env，请保留原文件，不要直接覆盖。
# 修改配置后重启正在运行的网页或终端问答服务。

# 必填：DeepSeek 密钥，用于问题补全、查询改写和回答生成。
DEEPSEEK_API_KEY=

# 必填：硅基流动密钥，用于文本向量化和重排。
SILICONFLOW_API_KEY=

# 可选：与 config.py 的默认模型一致。
DEEPSEEK_MODEL=deepseek-flash

# 可选：当前使用的知识库集合，必须与已入库的集合及父级快照一致。
CAMPUSMIND_COLLECTION=campus_handbook_bge_m3_v2

# 其他参数（路径、切片长度、召回数量、超时等）在 config.py 中调整。
# 本示例可随项目分享；填写真实密钥后的 .env 不应提交到代码仓库。
